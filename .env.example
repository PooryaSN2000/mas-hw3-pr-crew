# ==============================================================================
# PR Crew Starter Kit Configuration (Zero-Cost Friendly!)
# Copy this file to `.env` and fill in your local or free-tier settings.
# NEVER commit `.env` to Git!
# ==============================================================================

# --- LLM Provider (OpenAI-compatible endpoint) ---
# Option A: Local Ollama -> http://localhost:11434/v1
# Option B: Kaggle GPU Notebook Tunnel -> https://<tunnel-id>.trycloudflare.com/v1
# Option C: Free-tier Cloud API (e.g., Groq, OpenRouter free models, Gemini OpenAI compat)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:4b

# --- Observability / Tracing (Arize Phoenix) ---
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=pr-crew-hw3

# --- Safety Guardrails (Required for Guardrails badge & budget protection) ---
MAX_AGENT_STEPS=15
MAX_TOKEN_BUDGET=50000

# --- Optional: GitHub Personal Access Token (only needed for Real World PR badge) ---
# GITHUB_TOKEN=
