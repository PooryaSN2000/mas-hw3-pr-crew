# Workflow config illustrating ISSUE-05 parser problems
workflow: nightly_sync

task fetch:
  command: echo   # inline comment should be ignored by parser
  param message=sync_payload  # trailing comment on param

task format:
  command: upper
  depends_on: fetch  # wait for fetch to complete
  param from=fetch

